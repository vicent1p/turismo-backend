# Server configuration
PORT=3000
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201
CORS_ORIGINS=http://localhost:4200,http://localhost:4201

# Reverse Proxy / Throttler IP detection:
TRUST_PROXY_HOPS=1   # prod detrás de 1 proxy (Apache/Nginx/Plesk)
# TRUST_PROXY_HOPS=0 # local sin proxy

# Media uploads (local disk path or mounted persistent volume, plus optional public origin URL)
UPLOAD_DIR="./uploads"
PUBLIC_BASE_URL=""

# PostgreSQL connection string (Prisma / TypeORM)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/turismo_2027?schema=public"

# Database Connection Pool & Resilience Configuration:
# - DB_POOL_MAX: Máximo de conexiones simultáneas por proceso/instancia (default 20).
#   REGLA DE DIMENSIONAMIENTO:
#   (Instancias_de_Node_o_PM2 * DB_POOL_MAX) debe ser MENOR que el 'max_connections' de PostgreSQL
#   (restando al menos 3 a 5 conexiones reservadas para administradores y tareas de mantenimiento).
#   Ejemplo: Si postgres tiene max_connections = 100 y corres 4 workers de PM2,
#   configura DB_POOL_MAX <= 20 (4 * 20 = 80 conexiones máx, dejando 20 libres).
DB_POOL_MAX=20

# - DB_POOL_MIN: Conexiones "calientes" mínimas mantenidas abiertas para evitar latencia de handshake SSL (default 2).
DB_POOL_MIN=2

# - DB_POOL_CONNECTION_TIMEOUT_MS: Tiempo máximo en ms que una consulta espera por una conexión libre del pool
#   antes de lanzar un error 503/timeout en lugar de quedarse congelada indefinidamente (default 5000).
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# - DB_POOL_IDLE_TIMEOUT_MS: Tiempo máximo en ms que una conexión puede estar ociosa en el pool antes de cerrarse (default 30000).
DB_POOL_IDLE_TIMEOUT_MS=30000

# - DB_SLOW_QUERY_MS: Umbral en ms para emitir un aviso (warning) de consulta lenta (maxQueryExecutionTime)
#   sin inundar los logs con todas las queries rápidas (default 1000).
DB_SLOW_QUERY_MS=1000

# JWT configuration (use a strong random secret in production)
JWT_SECRET="replace-with-a-strong-random-secret"
JWT_EXPIRES_IN="8h"

