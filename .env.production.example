# ==============================================================================
# CONFIGURACIÓN DE PRODUCCIÓN - TURISMO MAGDALENA (PLESK / LINUX)
# Copia este contenido a tu archivo .env en el servidor de producción
# ==============================================================================

NODE_ENV="production"
PORT=3000

# Dominios autorizados para CORS en producción
ALLOWED_ORIGINS="https://proturismo.magdalena.gov.co,http://proturismo.magdalena.gov.co"
CORS_ORIGINS="https://proturismo.magdalena.gov.co,http://proturismo.magdalena.gov.co"

# Configuración del Proxy Inverso en Plesk (Nginx hacia Node.js)
TRUST_PROXY_HOPS=1

# Directorio de almacenamiento para fotos subidas
UPLOAD_DIR="./uploads"
PUBLIC_BASE_URL="https://proturismo.magdalena.gov.co"

# Conexión a la Base de Datos PostgreSQL de Producción
# Reemplaza USUARIO_PLESK y PASSWORD_PLESK con los datos creados en Plesk > Bases de datos
DATABASE_URL="postgresql://USUARIO_PLESK:PASSWORD_PLESK@localhost:5432/turismo_2027?schema=public"

# Parámetros del Pool de Conexiones de Base de Datos
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_SLOW_QUERY_MS=1000

# Clave Secreta para Tokens JWT (Debe ser una cadena larga y segura en producción)
JWT_SECRET="g32S87tca7opaBLYlULUO8BAXEiMYyak"
JWT_EXPIRES_IN="1d"
